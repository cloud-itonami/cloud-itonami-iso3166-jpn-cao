  :host/missing-probe "https://www.cao.go.jp/zzz-no-such-page-9f3c2a1b8e/"
  :host/front-page "https://www.cao.go.jp/index.html"
  :host/missing-redirects? false
  :host/missing-longer-than-front? false
  :host/head-reports-content-length? false
  :host/chrome-needles ["内閣府"]
